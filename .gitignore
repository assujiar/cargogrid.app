# CargoGrid — root .gitignore
# Established at Phase 0 Development Environment Foundation (CG-S5-PH0-006, Prompt 85),
# before the first non-documentation file lands, per ISS-2026-003.

# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/
build/
dist/

# Environment / secrets — never commit real values, only .env.example
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Supabase local runtime state (not the tracked supabase/config.toml or migrations)
supabase/.branches/
supabase/.temp/
supabase/logs/

# TypeScript / build caches
*.tsbuildinfo
.turbo/

# Test / coverage output
coverage/
playwright-report/
test-results/

# Load-test run output (CG-S10-ATW-024, Prompt 243) -- per-run pgbench logs and
# timestamped result captures are disposable; the checkpoint's own committed
# evidence file is explicitly kept (negation below), per ISS-2026-014.
scripts/load-tests/results/*
!scripts/load-tests/results/RESULTS_CG-S10-ATW-024.txt

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vercel
.vercel/

# Claude Code — personal local overrides, never shared/committed
.claude/settings.local.json
